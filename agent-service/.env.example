# Agent Service Environment Configuration (Sprint 8)

# Required: Secret key for verifying internal HS256 JWTs sent from Next.js proxy route
# Must match the INTERNAL_AGENT_JWT_SECRET configured in frontend/.env.local
INTERNAL_AGENT_JWT_SECRET=your-internal-jwt-secret-at-least-32-chars-long

# Required: OpenRouter API key for LLM calls (CrewAI agents)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional / Production: URL of the frontend for internal tool callbacks (defaults to http://localhost:3000)
# In production (e.g. Vercel), set to https://<your-vercel-domain>.vercel.app
NEXT_INTERNAL_URL=http://localhost:3000

# Optional: Host and Port settings (defaults to 0.0.0.0:8000)
PORT=8000
HOST=0.0.0.0
